# Copie este arquivo para .env.local e preencha com os dados do seu projeto.
# Supabase Dashboard → Project Settings → API (Data API).

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Se o painel mostrar apenas a "anon key" legada (JWT que começa com eyJ...),
# use esta variável no lugar da publishable:
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
